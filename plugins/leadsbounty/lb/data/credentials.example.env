# Leads Bounty Product Research — your PRIVATE credentials (this file stays on your computer).
# Edit it in a text editor. Never paste these values into Claude chat. Never commit this file.
# Environment variables with the same names override this file.

# Required for live research. Apify Console > Settings > API & Integrations > Personal API token.
APIFY_TOKEN=

# Demand evidence (Google Trends via SerpApi). serpapi.com > Dashboard > Your Private API Key.
# Without it, demand evidence is marked UNAVAILABLE and products stay PENDING.
SERPAPI_API_KEY=

# Optional: unattended marketing-angle generation by the worker (billed by Anthropic Console, separate from Claude subscriptions).
# Without it, run /leadsbounty report <job-id> inside Claude Code to write angles.
ANTHROPIC_API_KEY=
